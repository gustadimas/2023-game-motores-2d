  m_Name: 
  m_EditorClassIdentifier: 
  textoDialogo: {fileID: 672039368}
  falas:
  - "Quando percebi sua presen\xE7a, eu achei que n\xE3o passaria nem do primeiro..."
  - Bem, acho que equivoquei!
  - "Por\xE9m o pr\xF3ximo desafio ser\xE1 bem mais dificil!"
  - "N\xE3o vou falar muito sobre, mas resumindo voc\xEA enfrentar\xE1 seu primeiro
    inimigo."
  - "Eles se chamam, \"Patruret\xE2ngulos\"!"
  - "At\xE9 que sou bom em dar nomes, hahahaha."
  - "Cuidado, caso eles te acertem, voc\xEA ter\xE1 que recome\xE7ar tudo novamente!"
  delayEntreLetras: 0.05
  CaixaDeDialogo: {fileID: 225149883}
  jogador: {fileID: 1028142122}
  gerenciadorPlataformas: {fileID: 0}
