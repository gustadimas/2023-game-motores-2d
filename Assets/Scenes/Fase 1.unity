  imagem: 0
  jogador: {fileID: 1917541001}
  textoDialogo: {fileID: 422485705}
  falas:
  - "Ol\xE1, aventureiro!"
  - Alguns me chamam de "Professor"
  - Eu sou um guia pessoal!
  - "A frente voc\xEA encontrar\xE1 alguns desafios."
  - "Voc\xEA precisar\xE1 ser esperto e inteligente para passar."
  - "Ser\xE1 que est\xE1 pronto?"
  - "Mas n\xE3o se preocupe, irei guiar-lo na sua jornada"
  - "Enfim, n\xE3o vou tomar mais seu tempo, boa sorte!"
  delayEntreLetras: 0.05
  CaixaDeDialogo: {fileID: 1729838716}
